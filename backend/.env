# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ailifehub?schema=public

# Authentication Security
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI Integration
OPENAI_API_KEY=your_openai_api_key_here
